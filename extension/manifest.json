{
  "manifest_version": 3,
  "name": "Tamil Nilam Parcel Lookup",
  "version": "0.1.0",
  "description": "Look up Tamil Nilam parcel details from sample coordinates.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://tngis.tn.gov.in/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://tngis.tn.gov.in/apps/gi_viewer/*", "https://tngis.tn.gov.in/map-viewer/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
